<%= render "home/landing" %>

<% if user_signed_in? %>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">

    <div class="flex justify-between items-center mb-8">
      <h1 class="font-bold text-3xl text-gray-900">Your Notes</h1>
      <%= link_to "New note", new_note_path,
          class: "rounded-lg px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm transition-colors" %>
    </div>

    <% if @notes.any? %>
      <div id="notes" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @notes.each do |note| %>
          <%= link_to note_path(note), class: "block" do %>
            <div class="border border-gray-200 rounded-lg p-4 h-full hover:shadow-md transition-shadow <%= note.color.presence %>">
              <p class="text-xl font-semibold text-gray-900"><%= note.title %></p>
              <p class="text-sm text-gray-500 font-medium mt-1">
                <%= note.created_at.strftime("%d %b %Y") %>
              </p>
              <p class="mt-3 text-gray-800">
                <%= truncate(note.description, length: 300) %>
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center my-16">
        <p class="text-gray-500 mb-4">No notes yet.</p>
        <%= link_to "Create your first note", new_note_path,
            class: "rounded-lg px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold" %>
      </div>
    <% end %>

  </div>
<% end %>