<nav class="bg-white shadow">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">

      <!-- Logo / Brand -->
      <div class="flex items-center">
        <%= link_to "Aura Notes", root_path, class: "text-xl font-bold text-gray-900" %>
      </div>

      <!-- Right side: Login / Log out -->
      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <span class="text-gray-700 text-sm"><%= current_user.email %></span>
          <%= button_to "Log out", destroy_user_session_path, method: :delete,
              class: "px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-75 cursor-pointer" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path,
              class: "px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-75 cursor-pointer" %>
        <% end %>
      </div>

    </div>
  </div>
</nav>