<div id="<%= dom_id note %>"
     class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 hover:shadow-md transition-shadow">

  <!-- Header: Title + Color swatch -->
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="text-lg font-semibold text-gray-900 leading-snug">
      <%= note.title %>
    </h3>

    <% if note.color.present? %>
      <span class="flex-shrink-0 w-4 h-4 rounded-full border border-gray-300"
            style="background-color: <%= note.color %>;"
            title="<%= note.color %>"></span>
    <% end %>
  </div>

  <!-- Description -->
  <% if note.description.present? %>
    <p class="text-sm text-gray-600 leading-relaxed mb-4">
      <%= truncate(note.description, length: 200) %>
    </p>
  <% end %>

  <!-- Footer -->
  <div class="text-xs text-gray-500 pt-3 border-t border-gray-100">
    <%= note.created_at.strftime("%b %d, %Y") %>
  </div>
</div>